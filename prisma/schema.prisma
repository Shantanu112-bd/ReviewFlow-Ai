generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String       @id @default(uuid())
  name           String
  email          String       @unique
  emailVerified  Boolean
  image          String?
  githubId       String?      @unique
  githubUsername String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sessions       Session[]
  accounts       Account[]
  repositories   Repository[]
  reviews        Review[]
}

model Repository {
  id           String        @id @default(uuid())
  githubId     String        @unique
  name         String
  fullName     String
  url          String
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  pullRequests PullRequest[]
}

model PullRequest {
  id           String     @id @default(uuid())
  githubId     String     @unique
  number       Int
  title        String
  status       String     // e.g., "OPEN", "MERGED", "CLOSED"
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  reviews      Review[]
}

model Review {
  id            String        @id @default(uuid())
  pullRequestId String
  pullRequest   PullRequest   @relation(fields: [pullRequestId], references: [id])
  reviewerId    String
  reviewer      User          @relation(fields: [reviewerId], references: [id])
  status        String        // e.g., "PENDING", "IN_PROGRESS", "COMPLETED", "FAILED"
  score         Int?          // 0 to 100
  summary       String?       // Executive summary generated by the Orchestrator
  recommendation String?      // e.g., "APPROVE", "REQUEST_CHANGES", "COMMENT"
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  agentResults  AgentResult[]
}

model AgentResult {
  id         String    @id @default(uuid())
  reviewId   String
  review     Review    @relation(fields: [reviewId], references: [id])
  agentName  String    // e.g., "SecurityAnalyzer", "PerformanceScanner"
  status     String    // e.g., "RUNNING", "SUCCESS", "ERROR"
  rawOutput  String?   // Optional raw LLM output for debugging
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  findings   Finding[]
}

model Finding {
  id            String      @id @default(uuid())
  agentResultId String
  agentResult   AgentResult @relation(fields: [agentResultId], references: [id])
  filePath      String
  line          Int?        // Optional, if the finding targets a specific line
  severity      String      // e.g., "INFO", "WARNING", "CRITICAL"
  message       String      // The actionable feedback
  codeSnippet   String?     // Associated code snippet context
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

# ------------------------------------------------------------------------------
# ReviewFlow AI - Environment Variables
# ------------------------------------------------------------------------------

# Database (Neon PostgreSQL)
# Example: postgresql://user:password@ep-cool-snowflake-123.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# Authentication (Better Auth)
# Generate a secure string using `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# The URL of your deployed Vercel application (or http://localhost:3000 locally)
BETTER_AUTH_URL="http://localhost:3000"

# GitHub App Integration
# Register an OAuth app in your GitHub Developer Settings
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Redis (Upstash)
# Example: rediss://default:password@euw1-cool-snowflake-123.upstash.io:30000
REDIS_URL=""

# Gemini (Agent Engine)
# Your Google Gemini API Key for running the AI Agents
GOOGLE_GENERATIVE_AI_API_KEY=""
